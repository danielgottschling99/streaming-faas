# Copy to benchmark/gcp.env and replace the private IPs.
SUT_IP=10.0.0.10
CLIENT_IP=10.0.0.20

SERVER_URL=http://${SUT_IP}:8080
CONNECT_HOST=${CLIENT_IP}
CONNECT_PORT=9000
FRAME_SOURCE_LISTEN=0.0.0.0:9000
FRAME_SINK_LISTEN=0.0.0.0:9100
FRAME_SINK_HOST=${CLIENT_IP}
FRAME_SCALE_HANDLER_HOST=${SUT_IP}
FRAME_SCALE_HANDLER_PORT=8080
FRAME_SCALE_OUTPUT_HOST=${CLIENT_IP}
FRAME_SCALE_OUTPUT_PORT=9100
FRAME_FRAMES=300
FRAME_MODE=burst
FRAME_FPS=30
SEGMENTATION_BENCHMARK_PASSES=12
SEGMENTATION_SCALE_WORKERS=4
